* {
    bg: #0a0c11ee;
    chip: #172539dd;
    fg: #ada37a;
    accent: #cc8a3e;
    seltext: #0a0c11;
    dim: #555555;
    background-color: transparent;
    text-color: var(fg);
}
window {
    width: 560px;
    border: 2px;
    border-color: var(accent);
    border-radius: 14px;
    background-color: var(bg);
    padding: 12px;
    children: [ inputbar, listview ];
}
inputbar {
    children: [ prompt, entry ];
    background-color: var(chip);
    border-radius: 10px;
    padding: 8px 12px;
    margin: 0px 0px 8px 0px;
}
prompt {
    text-color: var(accent);
    margin: 0px 10px 0px 0px;
}
entry {
    placeholder: "search";
    placeholder-color: var(dim);
}
listview {
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}
element {
    padding: 6px 10px;
    border-radius: 8px;
}
element selected {
    background-color: var(accent);
    text-color: var(seltext);
}
element-icon {
    size: 22px;
    margin: 0px 8px 0px 0px;
}
element-text {
    vertical-align: 0.5;
}
