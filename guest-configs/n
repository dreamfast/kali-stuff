#!/usr/bin/env python3
# =============================================================================
# n: terminal → Obsidian bridge for the CURRENT box ($BOX/$PLATFORM from the
# box's .envrc): append text/files/command output/termlog excerpts/todo
# checkboxes to the box's note (see USAGE for details).
import hashlib
import json
import os
import re
import shutil
import stat as stat_mod
import subprocess
import sys
from datetime import datetime

USAGE = """\
n: terminal → Obsidian bridge, append to the CURRENT box's note.
Run inside a box (`box` sets $BOX/$PLATFORM via direnv).

FORM
