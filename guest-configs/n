EXAMPLES
  n found sqli on /login; waf blocks union
  n -t findings -c "nxc smb $IP -u '' -p '' --shares"
  n -f recon/scan.txt.nmap "full range done"
  n -l                            # previous command + output
  n -l 2                          # the command two back
