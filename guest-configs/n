LANDING (same lookup as `box`; note must exist; run `box` first)
  htb  → 04 - HTB Boxes/NN - <Box>.md
  hs   → 12 - Hack Smarter/NN - <Box>.md
  cjca → 07 - Certifications/CJCA Exam/Targets/<Box>/<Box>.md
"""

MAX_LINES = 2000
MAX_BYTES = 122880

SECTIONS = {
    "recon": "Recon",
    "findings": "Findings",
    "foothold": "Foothold",
    "privesc": "Privesc",
    "notes": "Notes",
    "todo": "Todo",
    "flags": "Flags",
}

# selector forms accepted by -l / --last (shared by parser + extractor)
LAST_RE = re.compile(r"^(\d+)(?:-(\d+))?$")
# flags that end a -d word run (anything --long ends it too)
KNOWN_FLAGS = frozenset(("-t", "-f", "-c", "-l", "-d", "--"))
# a markdown checkbox line: `- [ ]` / `- [x]` (any bullet, any indent)
CHECK_RE = re.compile(r"^(\s*[-*+]\s+\[)([ xX])(\].*)$")


def parse_last(spec):
    """'-l' selector string → (lo, hi): 1-based, 1 = previous command.
    `-l 2` → (2,2) just that one; `-l 1-3` → (1,3) the last three."""
    m = LAST_RE.match(spec)
    if not m:
        die(f"bad -l selector '{spec}': use N or A-B (1 = previous command)")
    a, b = int(m.group(1)), int(m.group(2) or m.group(1))
    if a < 1 or b < 1:
        die("-l positions start at 1 (1 = previous command)")
    return min(a, b), max(a, b)


def last_label(lo, hi):
    if lo == hi:
        return "previous command" if lo == 1 else f"command {lo} back"
    return f"last {hi} commands" if lo == 1 else f"commands {lo}-{hi} back"


def todo_op(words):
    """A -d word run → (verb, N) lifecycle op, or None for plain text.
    `ls` lists; `done N`/`undo N` (1-based); other done/undo words = usage
    error (never silent text)."""
    if not words:  # `--todo=` with an empty value
        die("--todo= needs todo text")
    w0 = words[0].lower()
    if w0 in ("ls", "list"):
        return ("ls", 0) if len(words) == 1 else None  # 'ls the shares' = text
    if w0 in ("done", "undo"):
        if len(words) == 2 and words[1].isdigit() and int(words[1]) >= 1:
            return (w0, int(words[1]))
        die(f"-d {w0}: usage: n -d {w0} N   (numbers from `n -d ls`)")
    return None


def die(msg, code=1):
    print(f"n: {msg}", file=sys.stderr)
    sys.exit(code)


def stage_section(box):
    """Default section from the box's STAGE: .envrc is the source of truth
    (`stage <s>` rewrites it; panes read it fresh), $STAGE only as fallback.
    Unknown/missing → '' (legacy ## Notes/## Log)."""
    stage = ""
    root = os.environ.get("CTFS_ROOT", os.path.expanduser("~/work/ctf"))
    try:
        with open(os.path.join(root, box, ".envrc"), encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"^export STAGE=(\S+)", line)
                if m:
                    stage = m.group(1)
                    break
    except OSError:
        pass
    if not stage:
        stage = os.environ.get("STAGE", "")
    return SECTIONS.get(stage.strip().lower(), "")


def stdin_is_payload():
    """True for piped/redirected stdin (FIFO or regular file) — NOT a tty or
    chardev: kssh hands us /dev/null and that must not trip the pipe
    auto-detect (hijacked `n answer FLAG` into empty-stdin dies once)."""
    if sys.stdin.isatty():
        return False
    try:
        mode = os.fstat(0).st_mode
    except OSError:
        return False
    return stat_mod.S_ISFIFO(mode) or stat_mod.S_ISREG(mode)


# --------------------------------------------------------------------- args
def add_file(opts, path):
    """-f/--file= value: `-` means stdin instead of a real file."""
    if path == "-":
        opts["stdin"] = True
    else:
        opts["files"].append(path)


def parse_args(argv):
    opts = {"files": [], "cmds": [], "texts": [], "todos": [],
            "todo_ops": [], "sect": None, "lastsel": None, "stdin": False}
    args = argv[:]
    # answer/flag count ONLY as the first token: `n answer THU{...}`; the
    # same word anywhere else is plain note text
    if args and args[0] in ("answer", "flag"):
        opts["sect"] = "flags"
        args = args[1:]
    while args:
        a = args[0]
        if a in ("-f", "--file"):
            if len(args) < 2:
                die(f"{a} needs a file argument")
            add_file(opts, args[1])
            args = args[2:]
        elif a.startswith("--file="):
            add_file(opts, a[len("--file="):])
            args = args[1:]
        elif a == "-":
            opts["stdin"] = True; args = args[1:]
        elif a in ("-c", "--cmd", "--run"):
            if len(args) < 2:
                die(f"{a} needs a command argument (quote it)")
            opts["cmds"].append(args[1]); args = args[2:]
        elif a.startswith("--cmd="):
            opts["cmds"].append(a[len("--cmd="):]); args = args[1:]
        elif a in ("-t", "--type"):
            if len(args) < 2:
                die(f"{a} needs a section (recon|findings|foothold|privesc|notes|todo|flags)")
            if opts["sect"]:
                die("-t/--type given more than once")
            opts["sect"] = args[1]; args = args[2:]
        elif a.startswith("--type="):
            if opts["sect"]:
                die("-t/--type given more than once")
            v = a[len("--type="):]
            if not v:
                die("--type= needs a section (recon|findings|foothold|privesc|notes|todo|flags)")
            opts["sect"] = v; args = args[1:]
        elif a in ("-l", "--last"):
            # optional attached selector: the NEXT word, only if it is shaped
            # like N or A-B (a digit-leading comment word needs `--` first)
            if len(args) > 1 and LAST_RE.match(args[1]):
                opts["lastsel"] = args[1]; args = args[2:]
            else:
                opts["lastsel"] = "1"; args = args[1:]
        elif a.startswith("--last="):
            v = a[len("--last="):]
            if not LAST_RE.match(v) or int(v.split("-")[0]) < 1:
                die("--last=N needs integers >= 1 (N or A-B)")
            opts["lastsel"] = v; args = args[1:]
        elif a in ("-d", "--todo"):
            words = []
            args = args[1:]
            while args and args[0] not in KNOWN_FLAGS and not args[0].startswith("--"):
                words.append(args.pop(0))
            if not words:
                die("-d needs todo text (quote it if it starts with a dash)")
            op = todo_op(words)
            if op:
                opts["todo_ops"].append(op)
            else:
                opts["todos"].append(" ".join(words))
        elif a.startswith("--todo="):
            v = a[len("--todo="):]
            op = todo_op(v.split())
            if op:
                opts["todo_ops"].append(op)
            else:
                opts["todos"].append(v)
            args = args[1:]
        elif a == "--":
            args = args[1:]
            while args:
                opts["texts"].append(args[0]); args = args[1:]
        else:
            opts["texts"].append(a); args = args[1:]
    return opts


# ------------------------------------------------------------------ payload
ANSI_CSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")
ANSI_OSC = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
ANSI_DCS = re.compile(r"\x1b[PX^_][^\x1b]*(?:\x1b\\)")


def strip_ansi(s):
    s = ANSI_CSI.sub("", s)
    s = ANSI_OSC.sub("", s)
    s = ANSI_DCS.sub("", s)
    return s


def cap(text):
    """Cap a payload body at MAX_LINES lines / MAX_BYTES characters."""
    lines = text.split("\n")[:MAX_LINES]
    return "\n".join(lines)[:MAX_BYTES]


def build_payload(opts, ts):
    parts = []
    for todo in opts["todos"]:
        parts.append(f"- [ ] {todo}\n")
    if opts["texts"]:
        parts.append(f"- {ts}; {' '.join(opts['texts'])}\n")

    if opts["stdin"]:  # drain the pipe before running -c commands
        if sys.stdin.isatty():
            die("'-' needs a pipe: cmd | n -   (bare words are note text)")
        data = sys.stdin.buffer.read()
        if not data:
            die("stdin was empty — nothing to append")
        body = cap(strip_ansi(data.decode("utf-8", "replace")).replace("\r", ""))
        more = " _(truncated)_" if len(data) > MAX_BYTES \
            or data.count(b"\n") + 1 > MAX_LINES else ""
        label = pipe_label(last_cmdline())
        lab = f": `{label}`" if label else ""
        parts.append(f"- {ts}; piped{lab}{more}\n\n```\n{body}\n```\n\n")

    for f in opts["files"]:
        if not os.path.isfile(f):
            die(f"no such file: {f}")
        label = os.path.relpath(f) if os.path.abspath(f).startswith(os.getcwd() + os.sep) else f
        with open(f, "rb") as fh:
            raw = fh.read()
        body = cap(strip_ansi(raw.decode("utf-8", "replace")).replace("\r", ""))
        more = " _(truncated)_" if len(raw) > MAX_BYTES \
            or raw.count(b"\n") + 1 > MAX_LINES else ""
        parts.append(f"- {ts}; dumped: {label}{more}\n\n```\n{body}\n```\n\n")

    for c in opts["cmds"]:
        proc = subprocess.run(c, shell=True, check=False,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        rc = proc.returncode if proc.returncode >= 0 else 128 - proc.returncode
        body = cap(strip_ansi(proc.stdout.decode("utf-8", "replace")).replace("\r", ""))
        more = f" _(exit {rc})_" if rc != 0 else ""
        parts.append(f"- {ts}; ran: `{c}`{more}\n\n```\n{body}\n```\n\n")

    if opts["lastsel"] is not None:
        lo, hi = parse_last(opts["lastsel"])
        block = extract_last(lo, hi)
        if not opts["texts"]:
            parts.append(f"- {ts}; {last_label(lo, hi)} (termlog excerpt)\n")
        parts.append(f"\n```\n{block}\n```\n\n")

    return "".join(parts)


# ------------------------------------------------------------------- --last
# The termlog trail separator, as printed by _nb_cmd_sep (ctf-zsh-funcs):
#   ──▶ [user@host YYYY-MM-DD HH:MM:SS] <command line>
# ONLY this exact shape parses as a command boundary (autoscan banners and
# other bracketed prefixes don't match); legacy `── [` recordings are
# intentionally unsupported.
SEP_RE = re.compile(r"^──▶ \[\S+@\S+ \d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\] ?(.*)$")
SELF_FLAG_RE = re.compile(r"(^|\s)(--last(=\d+(?:-\d+)?)?|-l)(\s|$)")


def is_self(cmd):
    """Any && || ; | segment that is an `n` invocation with -l/--last counts;
    `cd ~/work/ctf/x && n -l` is still THIS call, not a previous command."""
    for seg in re.split(r"&&|\|\||;|\||\n", cmd):
        seg = re.sub(r'^(\w+=("([^"\\]|\\.)*"|\S+)\s+)+', "",
                     seg.strip())  # env prefixes (quoted values too)
        seg = re.sub(r"^(sudo|time|nohup|env)\s+", "", seg)  # runner prefixes
        toks = seg.split()
        if toks and (toks[0] == "n" or toks[0].endswith("/n")) and SELF_FLAG_RE.search(seg):
            return True
    return False


def clean_line(line):
    """Emulate \\r line-rewrites (progress bars): keep the last written
    state, and apply \\b overwrite semantics within each segment."""
    out = []
    for seg in line.split("\r"):
        buf, cur = [], 0
        for ch in seg:
            if ch == "\x08":
                cur = max(0, cur - 1)
            elif cur < len(buf):
                buf[cur] = ch
                cur += 1
            else:
                buf.append(ch)
                cur += 1
        out.append("".join(buf))
    for seg in reversed(out):
        if seg:
            return seg
    return ""


def is_prompt(s):
    s = s.strip()
    if not s:
        return False
    if s[0] in "┌└":  # kali 2-line prompt glyphs; check FIRST: the zle
        return True   # typed-echo line (└─$ <cmd>) is long but still a prompt
    if len(s) > 100:
        return False
    return bool(re.match(r"^[#$%~❯➜]", s) and re.search(r"[#❯$%➜]\s*$", s))


def find_recording(pane):
    troot = os.environ.get("TERMLOG_DIR", os.path.expanduser("~/work/termlogs"))
    best = None
    if os.path.isdir(troot):
        for sess in os.listdir(troot):
            sdir = os.path.join(troot, sess)
            if not os.path.isdir(sdir):
                continue
            for f in os.listdir(sdir):
                if f.endswith("_" + pane):
                    p = os.path.join(sdir, f)
                    try:
                        st = os.stat(p)
                    except OSError:
                        continue  # prune race: recording vanished mid-scan
                    if best is None or st.st_mtime > best[1]:
                        best = (p, st.st_mtime)
    return best[0] if best else None


def extract_last(lo, hi):
    """Termlog excerpt for commands lo..hi back (1 = previous): from the
    hi-back separator to the (lo-1)-back one (lo=1: this call's own)."""
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        die("-l needs a tmux pane recording (no $TMUX_PANE)")
    rec = find_recording(pane)
    if not rec:
        troot = os.environ.get("TERMLOG_DIR", os.path.expanduser("~/work/termlogs"))
        die(f"-l: no recording for pane {pane} in {troot}")

    with open(rec, "rb") as fh:
        raw = fh.read()[-524288:].decode("utf-8", "replace")
    raw = strip_ansi(raw)
    raw = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", raw)  # keep \n (\x0a)

    lines = [clean_line(l) for l in raw.split("\n")]
    lines = [l for l in lines if not re.match(r"^Script (started|done) on ", l)]

    seps = [(i, m.group(1)) for i, l in enumerate(lines) if (m := SEP_RE.match(l))]
    # empty-command separators are artifacts of non-interactive zsh scripts
    # (hook fired per line with no cmdline); never command boundaries
    real = [(i, c) for i, c in seps if c.strip()]

    # the trailing separator(s) are this very `n --last` call (preexec fired
    # before us); pop them and remember where the self-call section starts
    self_starts = []
    while real and is_self(real[-1][1]):
        self_starts.append(real[-1][0])
        real.pop()
    if len(real) < hi:
        die(f"-l: only {len(real)} command(s) recorded in this pane (need {hi})")
    start = real[-hi][0]
    # cut at the separator of the command (lo-1) back when lo > 1, else at
    # the first self-call separator (from there = THIS call's typed echo)
    if lo == 1:
        end = min(self_starts) if self_starts else len(lines)
    else:
        end = real[-(lo - 1)][0]
    blk = lines[start:end]

    # trim the trailing prompt + typed echo of the next command (lo=1: this call)
    budget = 12
    while blk and budget > 0:
        s = blk[-1].strip()
        if (s == "" or is_prompt(blk[-1]) or s.startswith("n: ")
                or SELF_FLAG_RE.search(s)
                or (len(s) < 40 and "n" in s and re.search(r"-\s*l|nl[^a-z]", s))):
            blk.pop()
            budget -= 1
            continue
        break
    while blk and blk[-1].strip() == "":
        blk.pop()
    if not blk:
        die("-l: nothing recorded for this pane yet")
    return cap("\n".join(blk))


# ------------------------------------------------------------------- piping
# trailing `... | n [- words]` of a piped command line, to strip for the
# bullet label (separator, optional env prefixes, the n token, any words)
PIPE_TAIL_RE = re.compile(r"\s*(\||&&|;)\s*(?:\w+=\S+\s+)*n(?:\s+\S+)*\s*$")


def last_cmdline():
    """Best-effort cmdline of this pane's latest trail entry (for `cmd | n`
    that IS the pipeline: preexec fires for the whole line). '' on failure:
    the label is cosmetic, never fatal."""
    try:
        pane = os.environ.get("TMUX_PANE", "")
        if not pane:
            return ""
        rec = find_recording(pane)
        if not rec:
            return ""
        with open(rec, "rb") as fh:
            raw = fh.read()[-524288:].decode("utf-8", "replace")
        raw = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", strip_ansi(raw))
        cmds = [m.group(1).strip() for l in raw.split("\n")
                if (m := SEP_RE.match(clean_line(l))) and m.group(1).strip()]
        return cmds[-1] if cmds else ""
    except OSError:
        return ""


def pipe_label(cmd):
    """Piped command minus its own `| n ...` tail: `nmap | n - sweep`
    labels as `nmap`. Unrelated trailing tokens (nmap, man, ...) survive."""
    if not cmd:
        return ""
    m = PIPE_TAIL_RE.search(cmd)
    return (cmd[:m.start()] if m else cmd).strip()


# ------------------------------------------------------------------- insert
def section_bounds(lines, sect):
    """(start, end) span of the LAST `## <sect>` heading — end = next
    top-level header/hr, fenced blocks respected — or None; sect=None →
    the legacy ## Notes/## Log fallback (shared by insert + todo ops)."""
    if sect:
        pat = re.compile(r"^##\s+" + re.escape(sect) + r"\s*$", re.IGNORECASE)
        idxs = [k for k, l in enumerate(lines) if pat.match(l.strip())]
    else:
        idxs = [k for k, l in enumerate(lines)
                if re.match(r"^##\s+(Notes|Log)\s*$", l.strip())]
    if not idxs:
        return None
    i = idxs[-1]
    j = i + 1
    fence = False
    while j < len(lines):
        ls = lines[j].lstrip()
        if ls.startswith(("```", "~~~")):
            fence = not fence
            j += 1
            continue
        if not fence and (lines[j].startswith("## ") or lines[j].startswith("---")):
            break
        j += 1
    return (i, j)


def insert(note, payload, sect):
    with open(note, encoding="utf-8") as fh:
        raw = fh.read()
    lines = raw.splitlines(keepends=True)
    b = section_bounds(lines, sect)
    if b:
        i, j = b
        k = j - 1
        while k > i and lines[k].strip() == "":
            k -= 1
        if not lines[k].endswith("\n"):  # last line may lack a trailing
            lines[k] += "\n"             # newline (Obsidian/manual edits)
        lines.insert(k + 1, payload)
        with open(note, "w", encoding="utf-8") as fh:
            fh.writelines(lines)
    else:
        if not raw.endswith("\n"):
            raw += "\n"
        raw += "\n## " + (sect or "Log") + "\n" + payload
        with open(note, "w", encoding="utf-8") as fh:
            fh.write(raw)


# ---------------------------------------------------------------- todo ops
def todo_items(lines, b):
    """(line_no, is_done, text) for each checkbox in span b, skipping fenced
    blocks (a `- [ ]` inside a dumped file is content, not a todo)."""
    out, fence = [], False
    for k in range(b[0] + 1, b[1]):
        ls = lines[k].lstrip()
        if ls.startswith(("```", "~~~")):
            fence = not fence
            continue
        if fence:
            continue
        m = CHECK_RE.match(lines[k])
        if m:
            out.append((k, m.group(2) != " ", m.group(3)[1:].strip()))
    return out


def todo_list(note, sect):
    with open(note, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    b = section_bounds(lines, sect)
    if not b:
        print(f"n: no ## {sect} section yet — add the first with: n -d <text>")
        return
    items = todo_items(lines, b)
    open_ = [t for _, d, t in items if not d]
    done = [t for _, d, t in items if d]
    trim = lambda t: t if len(t) <= 100 else t[:97] + "..."
    print(f"n: ## {sect} — {len(open_)} open, {len(done)} done"
          "  (n -d done N / n -d undo N)")
    for i, t in enumerate(open_, 1):
        print(f"  {i:>2}  {trim(t)}")
    if done:
        print("done:")
        for i, t in enumerate(done, 1):
            print(f"  {i:>2}  {trim(t)}")
    if not items:
        print("  (no checkboxes yet — n -d <text> to add)")


def todo_flip(note, sect, verb, num):
    """`done N` checks the Nth OPEN checkbox, `undo N` reopens the Nth done
    one (per-group numbering, exactly as `n -d ls` shows); only the [x]
    marker moves, the text stays untouched."""
    with open(note, encoding="utf-8") as fh:
        lines = fh.read().splitlines(keepends=True)
    b = section_bounds(lines, sect)
    if not b:
        die(f"-d {verb}: no ## {sect} section in the note (add with: n -d <text>)")
    target_done = verb == "undo"  # `done` flips an OPEN item, `undo` a done one
    hits = [(k, t) for k, d, t in todo_items(lines, b) if d == target_done]
    label = "done" if target_done else "open"
    if num > len(hits):
        die(f"-d {verb}: only {len(hits)} {label} todo(s) in ## {sect}"
            f" (numbers from `n -d ls`)")
    k, text = hits[num - 1]
    m = CHECK_RE.match(lines[k])
    lines[k] = f"{m.group(1)}{'x' if not target_done else ' '}{m.group(3)}"
    if not lines[k].endswith("\n"):
        lines[k] += "\n"
    with open(note, "w", encoding="utf-8") as fh:
        fh.writelines(lines)
    print(f"n: [{'x' if not target_done else ' '}] {text}")


# ---------------------------------------------------------------- clipboard
CLIP_CACHE = os.path.expanduser("~/.cache/n-clip.json")


def clipboard_image():
    """(bytes, ext) of an image on the X clipboard, else None.
    Silent on no-DISPLAY/no-xclip (plain ssh) and text-only clipboards."""
    if not os.environ.get("DISPLAY") or not shutil.which("xclip"):
        return None
    try:
        tgt = subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", "TARGETS", "-o"],
            check=False,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
        if tgt.returncode != 0:
            return None
        targets = tgt.stdout.decode("utf-8", "replace").split()
        pref = ("image/png", "image/jpeg", "image/jpg", "image/webp",
                "image/bmp", "image/gif", "image/tiff")
        mime = next((t for t in pref if t in targets), None) \
            or next((t for t in targets if t.startswith("image/")), None)
        if not mime:
            return None
        data = subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", mime, "-o"],
            check=False,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
        if data.returncode != 0 or len(data.stdout) < 64:
            return None
        if data.stdout[:8] == b"\x89PNG\r\n\x1a\n":
            ext = "png"          # magic beats mime for the extension
        elif data.stdout[:3] == b"\xff\xd8\xff":
            ext = "jpg"
        elif data.stdout[:3] == b"GIF":
            ext = "gif"
        else:
            ext = mime.split("/", 1)[1].replace("jpeg", "jpg")
        return data.stdout, ext
    except (subprocess.TimeoutExpired, OSError):
        return None


def clip_seen(note, digest):
    try:
        with open(CLIP_CACHE) as fh:
            return json.load(fh).get(note) == digest
    except (OSError, ValueError):
        return False


def clip_mark(note, digest):
    try:
        try:
            with open(CLIP_CACHE) as fh:
                state = json.load(fh)
        except (OSError, ValueError):
            state = {}
        state[note] = digest
        os.makedirs(os.path.dirname(CLIP_CACHE), exist_ok=True)
        with open(CLIP_CACHE, "w") as fh:
            json.dump(state, fh)
    except OSError:
        pass


def save_attachment(data, ext, box, obsidian):
    """Write the image into the vault's Attachments/<box>/ (folder created
    if missing) → wikilink filename (Obsidian resolves it vault-wide)."""
    adir = os.path.join(obsidian, "Attachments", box)
    os.makedirs(adir, exist_ok=True)
    slug = re.sub(r"[^a-z0-9]+", "-", box.lower()).strip("-") or "box"
    base = datetime.now().astimezone().strftime(f"scr-{slug}-%Y%m%d-%H%M%S")
    name = f"{base}.{ext}"
    n = 1
    while os.path.exists(os.path.join(adir, name)):
        n += 1
        name = f"{base}-{n}.{ext}"
    with open(os.path.join(adir, name), "wb") as fh:
        fh.write(data)
    return name


def embed_clipboard(note, sect, box, obsidian):
    """Append a clipboard image below the just-written payload (once per
    note per image; same clipboard in a later call doesn't re-embed)."""
    img = clipboard_image()
    if not img:
        return
    data, ext = img
    digest = hashlib.sha256(data).hexdigest()
    if clip_seen(note, digest):
        return
    name = save_attachment(data, ext, box, obsidian)
    insert(note, f"\n![[{name}]]\n", sect)
    clip_mark(note, digest)
    print(f"n: + screenshot {name}")
    # consume: the image is in the note now; clear the clipboard so a stale
    # shot doesn't leak into later notes (vdagent shares this slot with the
    # host). Best-effort.
    try:
        subprocess.run(["xclip", "-selection", "clipboard", "-i"],
                       input=b"", check=False, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except (subprocess.TimeoutExpired, OSError):
        pass


# --------------------------------------------------------------------- main
def main():
    argv = sys.argv[1:]
    if any(a in ("-h", "--help") for a in argv):
        print(USAGE, end="")
        return 0

    box = os.environ.get("BOX", "")
    if not box:
        die("not in a box (no $BOX); run `box` first")
    if not argv and sys.stdin.isatty():
        die("usage: n [-t section] <text words...> | n answer <flag> | n -f <file> ... | n -c <cmd> ... | n -d <todo> | cmd | n [-]")

    obsidian = os.environ.get("OBSIDIAN_ROOT", os.path.expanduser("~/obsidian"))
    title = box[:1].upper() + box[1:]
    plat = os.environ.get("PLATFORM", "")
    if plat == "HTB":
        fold, pat = os.path.join(obsidian, "04 - HTB Boxes"), r"^\d{2} - " + re.escape(title) + r"\.md$"
    elif plat == "HS":
        fold, pat = os.path.join(obsidian, "12 - Hack Smarter"), r"^\d{2} - " + re.escape(title) + r"\.md$"
    elif plat == "CJCA":
        fold = os.path.join(obsidian, "07 - Certifications", "CJCA Exam", "Targets", title)
        pat = r"^" + re.escape(title) + r"\.md$"
    elif plat == "WEB":
        print(f"n: web box '{box}' has no note (only htb/hs/cjca boxes get notes); nothing to append",
              file=sys.stderr)
        return 0
    else:
        die(f"$PLATFORM must be HTB, HS, CJCA or WEB (got '{plat}')")

    opts = parse_args(argv)
    # `cmd | n [comment]`: with no other payload, piped/redirected stdin IS
    # the payload (an explicit `-` forces stdin even alongside other options)
    if (not opts["stdin"] and not opts["files"] and not opts["cmds"]
            and opts["lastsel"] is None and not opts["todos"]
            and not opts["todo_ops"] and stdin_is_payload()):
        opts["stdin"] = True
    if not (opts["texts"] or opts["files"] or opts["cmds"] or opts["todos"]
            or opts["todo_ops"] or opts["stdin"] or opts["lastsel"] is not None):
        die("usage: n [-t section] <text words...> | n answer <flag> | n -f <file> | n -c <cmd> | n -d <todo> | n -l [N|A-B] <comment...>")

    sect = ""
    if opts["sect"]:
        sect = SECTIONS.get(opts["sect"].lower(), "")
        if not sect:
            die(f"unknown -t '{opts['sect']}' (recon|findings|foothold|privesc|notes|todo|flags)")
    else:
        sect = "Todo" if (opts["todos"] or opts["todo_ops"]) else stage_section(box)

    fname = None
    if os.path.isdir(fold):
        rx = re.compile(pat, re.IGNORECASE)
        for f in sorted(os.listdir(fold)):
            if rx.search(f):
                fname = f
                break
    if not fname:
        die(f"no note for '{box}' in {fold}; run `box` first?")
    note = os.path.join(fold, fname)

    ts = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M")
    payload = build_payload(opts, ts)
    if payload.strip():
        insert(note, payload, sect)
        print(f"n: appended to {note}")
        embed_clipboard(note, sect, box, obsidian)
    elif not opts["todo_ops"]:
        die("nothing to append")
    for verb, num in opts["todo_ops"]:  # after any append, so fresh items count
        if verb == "ls":
            todo_list(note, sect)
        else:
            todo_flip(note, sect, verb, num)
    return 0


if __name__ == "__main__":
    sys.exit(main())
