#!/usr/bin/env python3
"""box: scaffold + open a CTF/lab workspace.

One box = one dir + direnv env + Obsidian note + tmux session (3 panes,
termlogged) + auto-recon flags. Auto-recon fires only at session creation
with a real IP; an IP-less session is killed + recreated when re-run with
-i + flags (see -h for usage).
"""

from __future__ import annotations

import argparse
import glob
import os
import re
import subprocess
import sys
import time
from datetime import date
from pathlib import Path

ROOT = Path(os.environ.get("CTFS_ROOT", os.path.expanduser("~/work/ctf")))
OBSIDIAN = Path(os.environ.get("OBSIDIAN_ROOT", os.path.expanduser("~/obsidian")))

PLATFORMS = {  # cli flag -> (vault folder, PLATFORM env, index file, index section)
    "htb": ("04 - HTB Boxes", "HTB", "HTB Boxes Index.md", "Easy"),
    "hs": ("12 - Hack Smarter", "Hack Smarter", "Hack Smarter Index.md", "Machines"),
    "cjca": ("07 - Certifications/CJCA Exam/Targets", "CJCA", "", ""),
}
PLATFORM_ENV = {"htb": "HTB", "hs": "HS", "cjca": "CJCA"}  # cli flag -> PLATFORM env value in .envrc


def run(*cmd: str, devnull: bool = False) -> subprocess.CompletedProcess:
    """Run a command, never raise; a missing binary returns a 127 stub
    (returncode guards keep working). devnull=True mutes BOTH streams
    (stdout is None then — fire-and-forget calls only)."""
    try:
        if devnull:
            return subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return subprocess.run(cmd, check=False, capture_output=True, text=True)
    except FileNotFoundError:
        return subprocess.CompletedProcess(args=list(cmd), returncode=127)


def tmux(*args: str, quiet: bool = False) -> subprocess.CompletedProcess:
    return run("tmux", *args, devnull=quiet)


def say(msg: str) -> None:
    print(f"box: {msg}")


# --------------------------------------------------------------------- listing

def envrc_value(text: str, key: str) -> str:
    m = re.search(rf"^(?:export )?{key}=(.*)$", text, re.MULTILINE)
    return m.group(1).strip() if m else ""


def envrc_field(envrc: Path, key: str) -> str:
    return envrc_value(envrc.read_text(), key)


def list_boxes(mode: str) -> int:
    """mode=active: only boxes with a live tmux session; mode=all: every box, newest first."""
    if not ROOT.is_dir():
        say(f"no {ROOT}")
        return 1
    sessions = {}
    res = tmux("list-sessions", "-F", "#{session_name}")
    if res.returncode == 0:
        for line in res.stdout.splitlines():
            sessions[line.strip()] = None
    rows = []
    for d in sorted(ROOT.iterdir()):
        envrc = d / ".envrc"
        if not d.is_dir() or not envrc.is_file():
            continue
        name = d.name
        if name in sessions:
            att = tmux("display-message", "-p", "-t", f"={name}", "#{session_attached}")
            state = "attached" if att.returncode == 0 and att.stdout.strip() == "1" else "detached"
        else:
            state = "none"
        if mode == "active" and state == "none":
            continue
        marker = next((d / f for f in (".box", ".newbox") if (d / f).is_file()), d)
        try:
            created = marker.stat().st_mtime
        except OSError:
            created = 0
        env = envrc.read_text()  # one read; IP/PLATFORM/STAGE all come from it
        rows.append((created, name, envrc_value(env, "IP") or "-",
                     envrc_value(env, "PLATFORM") or "-", envrc_value(env, "STAGE") or "-", state))
    if not rows:
        print("no active box sessions (box -a lists all boxes)" if mode == "active"
              else f"no boxes in {ROOT}")
        return 0
    print(f"{'NAME':<16} {'IP':<16} {'PLATFORM':<10} {'STAGE':<9} SESSION")
    for _, *cols in sorted(rows, key=lambda r: r[0], reverse=True):
        print(f"{cols[0]:<16} {cols[1]:<16} {cols[2]:<10} {cols[3]:<9} {cols[4]}")
    return 0


# ------------------------------------------------------------------ notes

def title_of(name: str) -> str:  # bash ${name^}: first char upper, rest untouched
    return name[:1].upper() + name[1:]


def note_path_for(name: str, plat: str) -> Path | None:
    """Existing note path for the box (htb/hs: NN - Title.md, case-insensitive;
    cjca: Targets/<Title>/<Title>.md), or None."""
    title = title_of(name)
    folder, _, _, _ = PLATFORMS[plat]
    nfold = OBSIDIAN / folder / title if plat == "cjca" else OBSIDIAN / folder
    if not nfold.is_dir():
        return None
    if plat == "cjca":
        return nfold / f"{title}.md" if (nfold / f"{title}.md").is_file() else None
    pat = re.compile(rf"^\d\d - {re.escape(title.lower())}\.md$")
    for f in nfold.glob("*.md"):
        if pat.match(f.name.lower()):
            return f
    return None


def next_note_path(name: str, plat: str) -> Path:
    """First free numbered note path (max existing NN + 1)."""
    title = title_of(name)
    folder, _, _, _ = PLATFORMS[plat]
    nfold = OBSIDIAN / folder / title if plat == "cjca" else OBSIDIAN / folder
    nfold.mkdir(parents=True, exist_ok=True)  # cjca machine folder
    if plat == "cjca":
        return nfold / f"{title}.md"
    prev = 0
    for f in nfold.glob("[0-9][0-9]*"):
        if f.is_file() and f.name[:2].isdigit():
            prev = max(prev, int(f.name[:2]))
    return nfold / f"{prev + 1:02d} - {title}.md"


NOTE_TEMPLATE = """# {title}

- platform: {plat}
- target: {target}
- started: {today}{recreated}

## Recon

## Findings

## Foothold

## Privesc

## Notes
"""


def write_note(path: Path, title: str, plat: str, target: str, recreated: bool = False) -> None:
    path.write_text(NOTE_TEMPLATE.format(
        title=title, plat=plat, target=target or "?",
        today=date.today().isoformat(),  # noqa: DTZ011 -- local date, matches `date +%F`
        recreated=" (note recreated)" if recreated else ""))


def index_note(plat: str, entry: str) -> None:
    """Insert `- [[entry]] 🟡` under the platform index section (append section if missing)."""
    folder, _, idx, sect = PLATFORMS[plat]
    idx_path = OBSIDIAN / folder / idx
    if not idx_path.is_file() or f"[[{entry}]]" in idx_path.read_text():
        return
    lines = idx_path.read_text().splitlines(keepends=True)
    i = next((k for k, l in enumerate(lines)
              if re.match(rf"^##\s+{re.escape(sect)}\s*$", l.strip())), None)
    if i is None:
        lines.append(f"\n## {sect}\n- [[{entry}]]\n")
    else:
        j = i + 1
        while j < len(lines) and not (lines[j].startswith("##") or lines[j].startswith("---")):
            j += 1
        k = j - 1
        while k > i and lines[k].strip() == "":
            k -= 1
        lines.insert(k + 1, f"- [[{entry}]] \U0001F7E1\n")
    idx_path.write_text("".join(lines))
    say(f"indexed in {idx}")


def create_or_recreate_note(name: str, plat: str, target: str, recreated: bool = False) -> tuple[Path | None, bool]:
    """(path, created?) — creates the note if missing (scaffold or re-enter paths)."""
    found = note_path_for(name, plat)
    if found is not None:
        return found, False
    path = next_note_path(name, plat)
    if path.parent.is_dir():  # next_note_path already mkdirs (cjca machine folder)
        write_note(path, title_of(name), plat, target, recreated=recreated)
        say(("note was missing; recreated: " if recreated else "note created: ") + str(path))
        return path, True
    say(f"vault folder not found: {path.parent}; note skipped")
    return None, False


# ------------------------------------------------------------- AGENTS.md

def write_box_agents_md(bdir: Path, name: str, ip: str, platform: str, note: Path | None) -> None:
    (bdir / "AGENTS.md").write_text(f"""# {name} (CTF box)

- box: {name}
- platform: {platform or 'none'}
- ip: {ip or 'unknown (set: box -b ' + name + ' -i <ip>)'}
- note: {note or 'none (no Obsidian note for this box)'}

Live state (STAGE, IP) lives in .envrc (direnv); `t` prints the context.
Recon output lands in recon/, findings/notes go to the Obsidian note via `n`.
""")


def refresh_box_agents_md(bdir: Path, target: str, notepath: Path | None) -> None:
    p = bdir / "AGENTS.md"
    text = p.read_text()
    if target and target != "REPLACE_ME" and f"- ip: {target}" not in text:
        text = re.sub(r"^- ip:.*", f"- ip: {target}", text, flags=re.MULTILINE)
    if notepath and f"- note: {notepath}" not in text:
        text = re.sub(r"^- note:.*", f"- note: {notepath}", text, flags=re.MULTILINE)
    p.write_text(text)


# ------------------------------------------------------------- scaffolding

# TUN0: this box's VPN exit (tun0 IPv4) — exported ONLY while the VPN is up.
# Direnv snapshots it when .envrc is (re)evaluated: cd in, direnv reload,
# `stage` switch, or a box -i IP sync (all rewrite/trigger the eval; panes
# pick it up at their next prompt). Connect the VPN BEFORE entering the box.
TUN0_BLOCK = """_tun0=$(ip -4 addr show tun0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)
[ -n "$_tun0" ] && export TUN0=$_tun0
unset _tun0
"""


def write_envrc(bdir: Path, name: str, target: str, platform: str) -> None:
    (bdir / ".envrc").write_text(
        f"""# {name}: per-box environment (direnv: loads on cd in, unloads on cd out)
# Edited this file? Run: direnv allow {bdir}
export BOX={name}
export IP={target or 'REPLACE_ME'}
export PLATFORM={platform}
export STAGE=recon
""" + TUN0_BLOCK)


def scaffold(bdir: Path, name: str, target: str, plat: str) -> Path | None:
    (bdir / "recon").mkdir(parents=True, exist_ok=True)
    platform = PLATFORM_ENV.get(plat, "")
    write_envrc(bdir, name, target, platform)
    run("direnv", "allow", str(bdir), devnull=True)  # pre-approve the fresh .envrc; missing direnv is fine (127 stub)
    (bdir / ".box").write_text(f"CREATED_IP={target or 'none'}\n")
    note = None
    if plat:
        note, created = create_or_recreate_note(name, plat, target)
        if not created and note is not None:
            say(f"note already exists: {note}")
        if note is not None and PLATFORMS[plat][2]:
            index_note(plat, note.name)
    write_box_agents_md(bdir, name, target, platform, note)
    say(f"scaffolded {bdir}")
    return note


def reenter(bdir: Path, name: str, target: str, plat: str) -> None:
    say(f"{bdir} already exists; re-entering")
    # note got renamed/deleted (e.g. `-old` after an exam attempt)? recreate so `n` can land
    notepath = None
    if plat:
        found = note_path_for(name, plat)
        if found is None:
            notepath, _ = create_or_recreate_note(name, plat, target, recreated=True)
        else:
            notepath = found
    # sync a newly-learned IP into .envrc (panes pick it up via the direnv hook)
    envrc = bdir / ".envrc"
    if not envrc.is_file():  # deleted by hand: regen the same fresh .envrc scaffold writes
        write_envrc(bdir, name, target, PLATFORM_ENV.get(plat, ""))
        run("direnv", "allow", str(bdir), devnull=True)
        say(".envrc was missing; regenerated")
    oldip = envrc_field(envrc, "IP")
    if target and target != "REPLACE_ME" and oldip != target:
        envrc.write_text(re.sub(r"^export IP=.*", f"export IP={target}", envrc.read_text(), flags=re.MULTILINE))
        run("direnv", "allow", str(bdir), devnull=True)
        say(f".envrc IP -> {target}")
    # TUN0 (tun0 VPN ip) migration for boxes scaffolded before it existed
    if "export TUN0" not in envrc.read_text():
        with envrc.open("a") as fh:
            fh.write("\n" + TUN0_BLOCK.lstrip("\n"))
        run("direnv", "allow", str(bdir), devnull=True)
        say(".envrc: +$TUN0 (tun0 VPN ip, set only while the VPN is up; panes pick it up at their next prompt)")
    # per-box AGENTS.md: recreate when missing, refresh ip/note when learned
    if not (bdir / "AGENTS.md").is_file():
        penv = envrc_field(envrc, "PLATFORM") if envrc.is_file() else ""
        write_box_agents_md(bdir, name, target or oldip, penv, notepath)
        say("AGENTS.md was missing; recreated")
    else:
        refresh_box_agents_md(bdir, target, notepath)


# ------------------------------------------------------------- tmux session

def wait_pane_ready(pane_target: str) -> None:
    """Poll /tmp/nb-pane-ready-<pane>-<pid> (the pane's LAST .zshrc step)
    before typing: pre-prompt input is SILENTLY SWALLOWED on this zsh
    build. ~30s budget."""
    res = tmux("display-message", "-p", "-t", pane_target, "#{pane_id}")
    if res.returncode != 0:
        return
    pane_id = res.stdout.strip()
    for _ in range(60):
        if glob.glob(f"/tmp/nb-pane-ready-{pane_id}-*"):
            time.sleep(0.3)
            return
        time.sleep(0.5)
    print(f"box: pane {pane_target} not ready after 30s; sending anyway", file=sys.stderr)


AUTOSCAN_TCP = r'''#!/bin/sh
# box auto-recon (TCP); generated by box, re-runnable.
# Needs $IP (direnv .envrc of the box dir); $PLATFORM/$WPSCAN_API_KEY optional.
set -u
[ -n "${IP:-}" ] || { echo "autoscan: $IP not set; run from inside the box dir (direnv)"; exit 1; }
cd "$(dirname "$0")/.." || exit 1

# TCP recon: rustscan discovers open ports (seconds), then nmap -sV -sC runs
# ONLY on those ports (rustscan's `--` passthrough pipes them automatically).
# TUNED: --tries 2 -b 500 — rustscan defaults (1 try, batch 1000) silently
# declare ports closed on slow/lossy targets (lost hours to a missed port once).
# No rustscan? falls back to nmap -p- full range with -Pn retry.
if command -v rustscan >/dev/null 2>&1; then
  echo "» [autoscan] rustscan full-range TCP discovery; nmap -sV -sC runs ON the open ports via rustscan's -- passthrough: $IP"
  rustscan -a "$IP" -r 1-65535 -t 3000 --tries 2 -b 500 --ulimit 5000 --no-banner -- \
    -sV -sC -Pn -vvv --open -oA recon/scan 2>&1 | tee recon/rustscan.txt
else
  echo "» [autoscan] TCP recon (no rustscan; nmap -p-): nmap -vvv -Pn -T4 --min-rate 1000 --max-retries 2 -sV -sC -p- --open $IP"
  nmap -vvv -Pn -T4 --min-rate 1000 --max-retries 2 -sV -sC -p- --open -oA recon/scan.txt "$IP"
fi

# nmap's .nmap output lives next to the -oA base nmap was given: the rustscan
# passthrough passes `-oA recon/scan` (→ recon/scan.nmap); the no-rustscan
# fallback uses `-oA recon/scan.txt` (→ recon/scan.txt.nmap). Resolve it:
# greps and the note append below must work in BOTH worlds.
NM=recon/scan.txt.nmap
[ -f "$NM" ] || NM=recon/scan.nmap
if [ ! -f "$NM" ]; then
  echo "» [autoscan] no nmap output produced; host down?"
  exit 1
fi
if ! grep -qE '/tcp[[:space:]]+open' "$NM"; then
  echo "» [autoscan] no open TCP ports found (host down or fully filtered?)"
fi
[ -n "${PLATFORM:-}" ] && n -t recon -f "$NM"

open_tab() {
  # $1 = window name, $2 = command to type into the new tab (after its zsh ready)
  _pid=$(tmux new-window -dP -t "$BOX" -n "$1" -c "$PWD" -F '#{pane_id}') || return 0
  tmux set-option -w -t "$_pid" automatic-rename off 2>/dev/null
  _i=0
  while [ "$_i" -lt 30 ]; do
    find /tmp -maxdepth 1 -name "nb-pane-ready-$_pid-*" 2>/dev/null | grep -q . && break
    sleep 1
    _i=$((_i + 1))
  done
  tmux send-keys -t "$_pid" "$2" Enter
}

if grep -qE '^(80|443)/tcp[[:space:]]+open' "$NM" 2>/dev/null && command -v whatweb >/dev/null 2>&1; then
  echo "» [autoscan] 80/443 open; whatweb"
  whatweb -a 3 "$IP" | tee recon/whatweb.txt
  [ -n "${PLATFORM:-}" ] && n -t recon -f recon/whatweb.txt
fi

if grep -qiE 'microsoft-ds|netbios-ssn|msrpc|MS-SQL|Microsoft Windows' "$NM" 2>/dev/null; then
  echo "» [autoscan] Windows/Samba indicators; opening enum4linux-ng + nxc tabs"
  command -v enum4linux-ng >/dev/null 2>&1 && \
    open_tab enum4linux-ng "enum4linux-ng -A $IP 2>&1 | tee recon/enum4linux.txt ; [ -n '$PLATFORM' ] && n -t findings -f recon/enum4linux.txt ; command -v nhosts >/dev/null 2>&1 && nhosts"
  command -v nxc >/dev/null 2>&1 && \
    open_tab nxc "nxc smb $IP -u '' -p '' --shares 2>&1 | tee recon/nxc.txt ; [ -n '$PLATFORM' ] && n -t findings -f recon/nxc.txt"
fi

if { grep -qi wordpress recon/whatweb.txt 2>/dev/null || grep -qE 'wp-[a-z]' "$NM" 2>/dev/null; } && command -v wpscan >/dev/null 2>&1 && [ -n "${WPSCAN_API_KEY:-}" ]; then
  echo "» [autoscan] WordPress indicators; opening wpscan tab"
  open_tab wpscan "wpscan --url http://$IP --api-token $WPSCAN_API_KEY --plugins-detection mixed 2>&1 | tee recon/wpscan.txt ; [ -n '$PLATFORM' ] && n -t findings -f recon/wpscan.txt"
fi
echo "» [autoscan] done"
'''

AUTOSCAN_UDP = r'''#!/bin/sh
# box auto-recon (UDP top-100); generated by box, re-runnable.
set -u
[ -n "${IP:-}" ] || { echo "autoscan-udp: $IP not set; run from inside the box dir (direnv)"; exit 1; }
cd "$(dirname "$0")/.." || exit 1

echo "» [autoscan-udp] nmap -vvv -T4 --min-rate 500 --max-retries 2 -sU -sV -sC --top-ports 100 $IP"
nmap -vvv -T4 --min-rate 500 --max-retries 2 -sU -sV -sC --top-ports 100 -oA recon/scan-udp.txt "$IP"
if grep -q "0 hosts up" recon/scan-udp.txt.nmap 2>/dev/null; then
  echo "» [autoscan-udp] host down on default probes; retrying with -Pn"
  nmap -vvv -Pn -T4 --min-rate 500 --max-retries 2 -sU -sV -sC --top-ports 100 -oA recon/scan-udp.txt "$IP"
fi
[ -n "${PLATFORM:-}" ] && n -t recon -f recon/scan-udp.txt.nmap
