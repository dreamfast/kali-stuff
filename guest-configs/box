def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(
        description="scaffold + open a CTF/lab workspace: direnv env + Obsidian note + "
                    "tmux session (3 panes, termlogged) + auto-recon flags.",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name_pos", nargs="?", metavar="name", help="box name (or use -b)")
    ap.add_argument("-b", "--box", dest="name_opt", metavar="NAME", help="box name (bare positional works too)")
    ap.add_argument("-i", "--ip", dest="ip", default="", metavar="IP",
                    help="target IP (omit while unknown; VPN/DHCP, CJCA exam)")
    ap.add_argument("-p", "--platform", dest="platform", default="", choices=["htb", "hs", "cjca"],
                    help="Obsidian note + index entry; cjca note = 07 - Certifications/"
                         "CJCA Exam/Targets/<NAME>/<NAME>.md")
    ap.add_argument("-s", "--scan", action="store_true",
                    help="TCP auto-recon in the right-top pane via recon/autoscan.sh\n"
                         "(re-runnable): rustscan full-range TCP discovery piped to nmap\n"
                         "-sV -sC on just the open ports (rustscan `--` passthrough;\n"
                         "nmap -p- fallback). whatweb on 80/443. Auto-tabs on detection:\n"
                         "Windows/Samba -> enum4linux-ng + nxc, WordPress -> wpscan (needs\n"
                         "WPSCAN_API_KEY). Raw scans append to the note via `n` (## Recon),\n"
                         "discovery tools via ## Findings.")
    ap.add_argument("-u", "--udp", action="store_true",
                    help="'udp_scan' tab: nmap -sU -sV -sC --top-ports 100 (appends to\n"
                         "## Recon via n on finish)")
    ap.add_argument("-a", "--all", action="store_true",
                    help="with no name: list ALL boxes, newest first")
    args = ap.parse_args(argv)

    name = args.name_opt or args.name_pos
    if args.name_opt and args.name_pos and args.name_opt != args.name_pos:
        say(f"conflicting box names: {args.name_pos} vs {args.name_opt}")
        return 1
    if not name:
        return list_boxes("all" if args.all else "active")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
        say("name may only contain letters, digits, '_' or '-'")
        return 1

    bdir = ROOT / name
    if (bdir / "nmap").is_dir() and not (bdir / "recon").is_dir():  # pre-rename migration
        (bdir / "nmap").rename(bdir / "recon")

    if not bdir.is_dir():
        scaffold(bdir, name, args.ip, args.platform)
    else:
        reenter(bdir, name, args.ip, args.platform)

    if run("tmux", "-V", devnull=True).returncode != 0:
        os.chdir(bdir)
        say(f"tmux not found; cd'd into {bdir}")
        return 0
    open_session(bdir, name, args.ip, args.platform, args.scan, args.udp)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
