def has_session(name: str) -> bool:
    return tmux("has-session", "-t", f"={name}", quiet=True).returncode == 0


def open_session(bdir: Path, name: str, target: str, plat: str, doscan: bool, doudp: bool) -> None:
    # an IP-less session never ran auto-recon: recreate it once an IP + auto
    # flags are known (.envrc is the IP source of truth, not just -i)
    created_ip = ""
    eff_ip = envrc_field(bdir / ".envrc", "IP")
    if has_session(name):
        marker = bdir / ".box"
        created_ip = envrc_field(marker, "CREATED_IP") if marker.is_file() else ""
        if not created_ip:  # marker missing (deleted dir / continuum restore)
            created_ip = "none"
        if created_ip == "none" and eff_ip and eff_ip != "REPLACE_ME" and (doscan or doudp):
            if os.environ.get("TMUX") and \
               tmux("display-message", "-p", "#{session_name}").stdout.strip() == name:
                say(f"you are INSIDE the {name} session; it cannot recreate itself from there.")
                extra = f' -p "{plat}"' if plat else ""
                say(f"re-run from OUTSIDE the box: tmux kill-session -t {name} && box -b {name} -i <ip>{extra} -s")
                return
            say(f"{name} was created without an IP; killing + recreating the session so auto-recon runs")
            tmux("kill-session", "-t", f"={name}")

    if not has_session(name):
        if tmux("new-session", "-d", "-s", name, "-c", str(bdir), quiet=True).returncode != 0:            # duplicate (e.g. a continuum-restored session raced in); force clean
            tmux("kill-session", "-t", f"={name}")
            tmux("new-session", "-d", "-s", name, "-c", str(bdir))
        # pane addresses via list-panes; immune to base-index settings (head = left, tail = newest)
        panes = tmux("list-panes", "-t", name, "-F", "#{window_id}.#{pane_index}").stdout.split()
        left = panes[0]
        tmux("split-window", "-h", "-t", left, "-c", str(bdir))       # right-top pane
        right = tmux("list-panes", "-t", name, "-F", "#{window_id}.#{pane_index}").stdout.split()[-1]
        tmux("split-window", "-v", "-t", right, "-c", str(bdir))      # right into top/bottom
        tmux("select-pane", "-t", left)                               # start focused in left
        say(f"created {name} with 3 panes")

        have_ip = bool(target or eff_ip) and (target or eff_ip) != "REPLACE_ME"
        if have_ip and doudp:
            tmux("new-window", "-d", "-t", name, "-n", "udp_scan", "-c", str(bdir))
            tmux("set-option", "-t", f"{name}:udp_scan", "automatic-rename", "off")

        if not have_ip:
            if doscan or doudp:
                say("no target IP; auto-recon skipped (re-run with -i <ip> once known: the session is recreated and recon starts)")
        else:
            if doscan:
                (bdir / "recon").mkdir(parents=True, exist_ok=True)
                sc = bdir / "recon" / "autoscan.sh"
                sc.write_text(AUTOSCAN_TCP)
                sc.chmod(0o755)
                say(f"auto-recon of {target or eff_ip} starting in the right-top pane (zsh recon/autoscan.sh: full nmap -p- -sV -sC, -Pn retry if the host looks down, +whatweb if 80/443, auto-tabs on detection)")
                wait_pane_ready(right)
                tmux("send-keys", "-t", right, "zsh recon/autoscan.sh", "Enter")
            if doudp:
                (bdir / "recon").mkdir(parents=True, exist_ok=True)
                sc = bdir / "recon" / "autoscan-udp.sh"
                sc.write_text(AUTOSCAN_UDP)
                sc.chmod(0o755)
                say(f"udp scan of {target or eff_ip} starting in the udp_scan tab (zsh recon/autoscan-udp.sh: top-100 UDP, -Pn retry if the host looks down)")
                wait_pane_ready(f"{name}:udp_scan")
                tmux("send-keys", "-t", f"{name}:udp_scan", "zsh recon/autoscan-udp.sh", "Enter")
    else:
        if created_ip == "none" and (doscan or doudp) and (not eff_ip or eff_ip == "REPLACE_ME"):
            say(f"{name} still has no target IP; auto-recon skipped (re-run with -i <ip> once known: the session is recreated and recon starts)")
        elif doscan or doudp:
            say(f"auto-recon flags fire only at session creation; {name} keeps its existing panes (re-scan anytime: zsh recon/autoscan.sh)")

    if os.environ.get("TMUX"):
        tmux("switch-client", "-t", f"={name}")
    else:
        # plain terminal (kitty): tmux takes over; `exit`/close returns here
        sys.stdout.flush()
        sys.stderr.flush()
        os.execvp("tmux", ["tmux", "attach", "-t", f"={name}"])


