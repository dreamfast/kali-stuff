# i3 config file (v4), https://i3wm.org/docs/userguide.html

set $mod Mod4

font pango:monospace 9

# ── theme: kitty dexpota palette ──
# bg #181c27 · fg #ada37a · selection #172539 · dim #555555 · muted #5b4f4a
# accent #cc8a3e · urgent #d33060 · cream #f3dab1 · focused tab #4a3b28
# i3 4.25: no *_titlebar/*_border lines; client.* = <border> <bg> <text> <indicator>
client.focused            #181c27 #4a3b28 #f3dab1 #cc8a3e
client.focused_tab_title  #181c27 #4a3b28 #f3dab1
client.focused_inactive   #5b4f4a #181c27 #555555 #555555
client.unfocused          #5b4f4a #172539 #555555 #555555
client.urgent             #d33060 #181c27 #f3f3f3 #d33060
client.background         #181c27 #ada37a
client.placeholder        #5b4f4a #172539 #555555 #555555


exec --no-startup-id dex --autostart --environment i3

exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# kill focused window
bindsym $mod+Shift+q kill

# start dmenu (a program launcher)
bindsym $mod+d exec --no-startup-id rofi -show drun

# clipboard history: clipd captures Ctrl+C selections (cliphist store);
# Super+c pops the frosted rofi picker (Enter recopy; delete mode: clip-menu -d)
bindsym $mod+c exec --no-startup-id clip-menu
# fallback if rofi is ever missing:
# bindsym $mod+d exec --no-startup-id dmenu_run -b -fn "monospace 8" -l 15 -nb '#181c27' -nf '#ada37a' -sb '#172539' -sf '#f3dab1'

# screenshots: flameshot (X11 legacy capture; the gtk portal can't take
# screenshots; see guest-configs/flameshot.ini)
bindsym Print exec --no-startup-id flameshot gui
bindsym Ctrl+Print exec --no-startup-id flameshot full -c
bindsym Shift+Print exec --no-startup-id flameshot full -p ~/Pictures/Screenshots

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# toggle the current container's split direction
bindsym $mod+q split toggle

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
# undo tabbed -> side-by-side. TRAP: i3 has NO trailing comments: a # after
# a command is parsed as part of the command and breaks the line
bindsym $mod+Shift+w layout default
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

set $ws1 "1:vpn"
set $ws2 "2:recon"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Top bar: polybar (launch.sh + for_window pin below); i3's bar{} stays
# disabled: polybar 3.x doesn't speak the i3bar protocol (blank double bar).
# bar {
#         status_command polybar -q top
#         position top
# }
exec_always --no-startup-id ~/.config/polybar/launch.sh
for_window [class="Polybar"] floating enable, border 0

exec_always --no-startup-id picom -b
workspace_layout tabbed
exec_always --no-startup-id /home/kali/.local/bin/wp-rotate --loop
# clipboard history daemon (flock-guarded; harmless on i3 reload/restart)
exec_always --no-startup-id /home/kali/.local/bin/clipd

bindsym $mod+Shift+t exec --no-startup-id kitty new-window

focus_follows_mouse yes
for_window [class="Caido"] floating enable

# urgent windows (reverse shell calling back) grab focus
for_window [urgent=latest] focus

# dialogs/menus/popups float instead of wrecking the tiling
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="notification"] floating enable
no_focus [window_type="notification"]

# notifications (dunst) + GUI privilege prompts (polkit agent)
exec --no-startup-id dunst
exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1

# ── CTF workflow layer ──

# gaps: 6px inner; outer -1 = smart (vanishes on single-window workspaces)
gaps inner 6
gaps outer -1
smart_gaps on

focus_wrapping yes
workspace_auto_back_and_forth yes

# 2px border, no title bar in split layout (tabbed/stacking keep theirs)
default_border pixel 2

# workspaces: 1 vpn · 2 recon predefined; 3+ ad hoc, rename with Super+u
# (keep the "N:" prefix to stay reachable via Super+N)
assign [class="Chromium"] $ws2
assign [class="Obsidian"] $ws6
bindsym $mod+u exec i3-input -F 'rename workspace to "%s"' -P 'Rename workspace: '

# scratchpad: burp/ghidra/wireshark auto-hide here (class = case-insensitive
# SUBSTRING: "urp" matches "burp_suite"); $mod+b stash, $mod+Shift+b summon
for_window [class="urp"] border pixel 1, move scratchpad
for_window [class="hidra"] border pixel 1, move scratchpad
for_window [class="Wireshark"] border pixel 1, move scratchpad
bindsym $mod+b move scratchpad
bindsym $mod+Shift+b scratchpad show

